# LUNA AI Video Editing Studio — Environment Variables

# Database (local dev uses docker-compose postgres)
DATABASE_URL=postgresql+asyncpg://luna:luna_dev_password@localhost:5432/luna

# Redis (local dev uses docker-compose redis)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Storage (configure for cloud deploy)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=luna-media

# Auth
SECRET_KEY=dev-secret-key-change-me
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Upload (local fallback when R2 not configured)
UPLOAD_DIR=./uploads
